# ============================================================================
# MediKiosk SIH-26 .gitignore
# Prevents committing sensitive credentials, environment files, build artifacts & dependencies
# ============================================================================

# 1. Environment & Sensitive Secrets (NEVER COMMIT CREDENTIALS)
.env
.env.*
*.env
backend/.env
backend/.env.*
!*.env.example
!backend/.env.example

# 2. Node.js & Dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
/package-lock.json
/package.json

# 3. Flutter, Dart & Build Artifacts
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
**/build/
/coverage/

# 4. Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# 5. Android & Platform Specific Build Output
/android/app/debug
/android/app/profile
/android/app/release
/windows/flutter/ephemeral
/linux/flutter/ephemeral

# 6. IDEs & Editors
.idea/
*.iml
*.ipr
*.iws
.vscode/
*.swp
*.history
.atom/

# 7. OS Metadata & Temporary Files
.DS_Store
Thumbs.db
*.class
*.log
*.pyc
.build/
.buildlog/
.svn/
.swiftpm/
.widget_preview/
migrate_working_dir/
